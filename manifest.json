{
  "manifest_version": 3,
  "name": "Cafepress QA Tools",
  "version": "1.0",
  "description": "QA tools for Cafepress: product info extraction and order lookup",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://*.pre.planetart.com/*",
    "*://*.stage.planetart.com/*",
    "*://www.cafepress.com/*",
    "*://cafepress.com/*",
    "*://www.cafepress.ca/*",
    "*://cafepress.ca/*",
    "*://www.cafepress.co.uk/*",
    "*://cafepress.co.uk/*",
    "*://www.cafepress.com.au/*",
    "*://cafepress.com.au/*",
    "*://admin.planetart.com/*",
    "*://login.planetart.com/*",
    "*://api.mymemory.translated.net/*",
    "*://api.qrserver.com/*",
    "*://*.supabase.co/*",
    "*://cdn.jsdelivr.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.pre.planetart.com/*",
        "*://*.stage.planetart.com/*",
        "*://www.cafepress.com/*",
        "*://cafepress.com/*",
        "*://www.cafepress.ca/*",
        "*://cafepress.ca/*",
        "*://www.cafepress.co.uk/*",
        "*://cafepress.co.uk/*",
        "*://www.cafepress.com.au/*",
        "*://cafepress.com.au/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Cafepress QA Tools",
    "default_icon": {
      "16": "icon16.png",
      "24": "icon48.png",
      "32": "icon48.png",
      "48": "icon48.png",
      "64": "icon128.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "24": "icon48.png", 
    "32": "icon48.png",
    "48": "icon48.png",
    "64": "icon128.png",
    "96": "icon128.png",
    "128": "icon128.png",
    "256": "icon256.png",
    "512": "icon512.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://*.supabase.co; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["cpdata/*.csv"],
      "matches": ["<all_urls>"]
    }
  ]
}
