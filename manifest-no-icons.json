{
  "manifest_version": 3,
  "name": "Cafepress QA Tools",
  "version": "1.0",
  "description": "QA tools for Cafepress: product info extraction and order lookup",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["*://cafus-cpsw-web.pre.planetart.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cafepress QA Tools"
  }
}
