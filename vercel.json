{
  "version": 2,
  "builds": [
    {
      "src": "upload.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/upload.html",
      "dest": "/upload.html"
    },
    {
      "src": "/",
      "dest": "/upload.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}

